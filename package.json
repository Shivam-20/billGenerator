{
  "name": "food-bill-pdf-generator",
  "version": "1.0.0",
  "description": "PDF invoice generator for food bills",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test.js",
    "start:script": "./scripts/start.sh",
    "stop:script": "./scripts/stop.sh",
    "restart": "./scripts/restart.sh",
    "status": "./scripts/status.sh",
    "dev:script": "./scripts/dev.sh",
    "health-check": "./scripts/health-check.sh",
    "health": "./scripts/health-check.sh --once",
    "logs": "tail -f logs/app.log",
    "logs:error": "tail -f logs/error.log",
    "logs:startup": "tail -f logs/startup.log",
    "monitor": "./scripts/health-check.sh --daemon",
    "monitor:stop": "./scripts/health-check.sh --stop",
    "monitor:status": "./scripts/health-check.sh --status"
  },
  "keywords": [
    "pdf",
    "invoice",
    "bill"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.13.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
